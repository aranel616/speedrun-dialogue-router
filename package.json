{
  "name": "speedrun-dialogue-router",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @sdr/web",
    "build": "npm run build --workspace @sdr/web",
    "preview": "npm run preview --workspace @sdr/web",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -p . --noEmit",
    "test": "jest --coverage",
    "test:web": "npm run test --workspace @sdr/web",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}

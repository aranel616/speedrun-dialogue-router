{
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^25.6.0",
    "jest": "^30.0.0",
    "nodemon": "^3.1.4",
    "ts-jest": "^29.4.9"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "server": "ts-node server/index.ts",
    "server:dev": "nodemon --exec ts-node --watch server --watch functions --watch scripts --ext ts server/index.ts",
    "build:client": "cd client && npm install && npm run build",
    "start": "node server/index.js"
  }
}

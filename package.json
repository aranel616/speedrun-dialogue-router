{
  "name": "speedrun-dialogue-router",
  "version": "0.1.0",
  "private": true,
  "description": "Finds the shortest path (by total character count) through a branching narrative dialogue script, with an interactive graph visualization. Built to analyze Life is Strange for speedrun route analysis.",
  "keywords": [
    "dialogue",
    "speedrun",
    "shortest-path",
    "graph",
    "narrative",
    "visualization",
    "life-is-strange"
  ],
  "author": "Sarah Day",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aranel616/speedrun-dialogue-router.git"
  },
  "bugs": {
    "url": "https://github.com/aranel616/speedrun-dialogue-router/issues"
  },
  "homepage": "https://github.com/aranel616/speedrun-dialogue-router#readme",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @sdr/web",
    "build": "npm run build --workspace @sdr/web",
    "preview": "npm run preview --workspace @sdr/web",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -p . --noEmit",
    "test": "jest --coverage",
    "test:web": "npm run test --workspace @sdr/web",
    "test:watch": "jest --watch",
    "test:all": "npm test && npm run test:web"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.55.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}

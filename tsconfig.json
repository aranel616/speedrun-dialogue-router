{
  // Solution config for the Node/CommonJS side of the workspace (engine,
  // shared, server, and the script data). ts-jest also reads these compiler
  // options. The web app is typechecked by its own tsconfig via `vite build`.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["jest", "node"],
    "noEmit": true
  },
  "include": [
    "packages/engine/src",
    "packages/shared/src",
    "packages/graph/src",
    "packages/scripts/lifeisstrange",
    "apps/server/src"
  ]
}
